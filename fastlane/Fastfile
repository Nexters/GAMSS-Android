default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Firebase App Distribution 에 베타 빌드 배포"
  lane :distribute do
    version_code = ENV["VERSION_CODE"]
    UI.user_error!("VERSION_CODE environment variable is not set") unless version_code

    firebase_app_id = ENV["FIREBASE_APP_ID"]
    UI.user_error!("FIREBASE_APP_ID environment variable is not set") unless firebase_app_id

    # Firebase App Distribution 은 Play Store 설치 경로가 아니라서 Play Asset Delivery(on-demand/
    # fast-follow)로 배포되는 온디바이스 모델(emotion/summary pack)을 못 받아온다. `internal`
    # buildType 은 이 모델들을 애초에 PAD 가 아니라 APK 에 그대로 번들된 assets 로 공급하므로
    # (data/build.gradle.kts, ModelAssetSource 참고) 별도 플래그 없이 테스터가 설치하자마자 모든
    # 기능을 바로 쓸 수 있다. 결과물은 AAB 가 아니라 plain APK.
    gradle(
      task: "clean :app:assembleInternal",
      properties: { "versionCode" => version_code }
    )

    firebase_app_distribution(
      app: firebase_app_id,
      service_credentials_file: ENV["FIREBASE_SERVICE_CREDENTIALS_FILE"],
      android_artifact_type: "APK",
      android_artifact_path: File.expand_path("../app/build/outputs/apk/internal/app-internal.apk", __dir__),
      groups: ENV["FIREBASE_TESTER_GROUPS"],
      release_notes: changelog_from_git_commits(
        commits_count: 1,
        pretty: "%h %s"
      )
    )
  end

  desc "Play Console 배포용 서명된 운영 AAB 빌드 (업로드는 아직 안 함 — 아래 참고)"
  lane :build_play_release_aab do
    version_code = ENV["VERSION_CODE"]
    UI.user_error!("VERSION_CODE environment variable is not set") unless version_code

    # release buildType 은 기존 PAD 정책(emotion=fast-follow, summary=on-demand) 그대로 — 이 빌드에는
    # internal 배포용 install-time 전환 같은 게 절대 섞이지 않는다.
    #
    # Play Console 자동 업로드(upload_to_play_store)는 아직 붙이지 않았다 — 서비스 계정 JSON secret
    # (PLAY_STORE_SERVICE_ACCOUNT_JSON)이 리포지토리에 아직 없다. 지금은 서명된 AAB 를 CI 아티팩트로만
    # 만들어 수동으로 Play Console 내부 테스트 트랙에 올린다. secret 이 준비되면 이 lane 뒤에
    # upload_to_play_store(track: "internal", aab: ..., json_key: ENV["PLAY_STORE_JSON_KEY_FILE"],
    # package_name: "com.gamss.android") 를 다시 추가하면 된다.
    gradle(
      task: "clean :app:bundleRelease",
      properties: { "versionCode" => version_code }
    )
  end
end