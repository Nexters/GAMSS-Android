<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            미출시 앱이라 Play 로는 애셋팩을 못 받는다(APP_UNAVAILABLE). 이 값이 있으면 Play Core 가
            팩을 내려받는 대신 <externalFilesDir>/local_testing 에 넣어둔 팩 APK 를 읽는다.
            온디바이스 모델 검증을 실기기에서 돌리는 유일한 경로다. 절차는 OnDeviceModelEvalTest 참고.
        -->
        <meta-data
            android:name="local_testing_dir"
            android:value="local_testing" />

        <!-- 디버그/검증 전용 화면. adb 로만 실행. -->
        <activity
            android:name=".debug.CardDebugActivity"
            android:exported="true"
            android:theme="@style/Theme.GAMSS" />
    </application>

</manifest>
